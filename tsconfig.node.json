{
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "outDir": "dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "../../types/*": ["./src/types/*"]
    }
  }
}
